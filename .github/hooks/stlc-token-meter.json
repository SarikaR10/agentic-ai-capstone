{
  "hooks": {
    "SubagentStart": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/token-meter.js start",
        "timeout": 10
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/token-meter.js stop",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "node .github/hooks/scripts/context-summary.js",
        "timeout": 10
      }
    ]
  }
}